{
  "uid": "waze-nuvem",
  "title": "Waze: visão da nuvem",
  "tags": [
    "waze"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Velocidade média por região (km/h)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "Média dos trechos com carros, a cada janela do fog (10 s).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS time, 'região ' || upper(regiao) AS metric, avg(vel_media) AS value\nFROM trechos WHERE $__timeFilter(ts) GROUP BY ts, regiao ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Trechos congestionados por região",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS time, 'região ' || upper(regiao) AS metric,\n       count(*) FILTER (WHERE estado = 'congestionado') AS value\nFROM trechos WHERE $__timeFilter(ts) GROUP BY ts, regiao ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Histórico: trechos que mais travam",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "A visão que só a nuvem tem: todas as regiões, ao longo do tempo (\"essa via trava sexta às 18h\").",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT upper(regiao) AS \"região\", trecho,\n       round(avg(vel_media)::numeric, 1) AS \"vel. média (km/h)\",\n       count(*) FILTER (WHERE estado = 'congestionado') AS \"janelas congestionadas\"\nFROM trechos WHERE $__timeFilter(ts)\nGROUP BY regiao, trecho ORDER BY 4 DESC, 3 ASC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Alertas recebidos",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "Os alertas chegam à nuvem só no lote seguinte; os carros já tinham sido avisados pelo fog.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT ts AS \"emitido\", recebido_em AS \"chegou na nuvem\", upper(regiao) AS \"região\",\n       trecho, tipo, decidido_em AS \"decidido em\"\nFROM alertas WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Idade dos dados ao chegar na nuvem (s)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "Dente de serra = lotes de 30 s; picos = WAN fora (store-and-forward nos fogs).",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT ts AS time, 'região ' || upper(regiao) AS metric,\n       avg(EXTRACT(EPOCH FROM recebido_em - ts)) AS value\nFROM trechos WHERE $__timeFilter(ts) GROUP BY ts, regiao ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "points",
            "pointSize": 5
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Lotes recebidos (itens)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "",
      "gridPos": {
        "x": 10,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT recebido_em AS time, origem AS metric, itens AS value\nFROM lotes WHERE $__timeFilter(recebido_em) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Rastros sincronizados após túnel",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 17,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS \"rastros\", coalesce(sum(pontos), 0) AS \"pontos\" FROM trilhas WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "title": "Último lote há (s)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuvem-pg"
      },
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuvem-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - max(recebido_em)) AS value FROM lotes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "editable": true
}